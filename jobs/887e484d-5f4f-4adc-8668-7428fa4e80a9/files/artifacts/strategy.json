  "oracleBiasQuestion": {
    "wording": "Using only public evidence timestamped at or before {asOfUtc}, what is the directional pressure on ETH over the next 24 hours on a scale from -100 (strong short) through 0 (neutral) to +100 (strong long)? Apply the fixed trend, funding, open-interest and Papertrade liquidation-map rubric and volatility multiplier in report.md. Report an int256 integer in [-100,100], without units, prose or JSON. Publish the required timestamped evidence packet separately. This score predicts price pressure, not a guaranteed profitable Papertrade trade.",
    "answerType": "int256",
    "min": -100,
    "max": 100,
    "tolerance": 10,
    "toleranceMeaning": "Absolute integer points for independently reproduced score; not a price or PnL tolerance. Three valid independent answers, median rounded to nearest integer; require max-min <=20. Otherwise oracle status INVALID and halt entries; never substitute an unavailable score with zero.",
    "scheduleUtc": "00:00 daily; evidence cutoff 00:00, answer before 01:00; expires after oracleMaxAgeSeconds for entry",
    "evidence": [
      "UTC cutoff and every retrieval timestamp, raw response hash and source URL",
      "Closed ETH candles: 24h/72h/168h returns, 24h realized volatility and 90-day volatility percentile",
      "Hyperliquid last-24h funding and OKX funding, normalized to 8h",
      "Hyperliquid and OKX OI change over exactly 24h from archived snapshots; no current-only change estimate",
      "Papertrade ETH range=5 liquidation map, 150 buckets and below/above fields; state as-of age <=60 seconds",
      "Protocol summary and queue, live payout parameter and implementation fingerprints",
      "Each component T,F,O,Q, volatility multiplier, unrounded aggregate, rounded score; missingness status"
    ]
  },
  "reviewInputs": [
    "Prior trusted version/hash and all current parameters; review may patch recommended only",
    "Reconciled trade-intent and receipt log: UTC times, instrument, side, full isolated margin, leverage, entries/exits/BBO, bustPrice, latency, actual payout mode and all fees, queued versus paid proceeds",
    "Per-trade loss basis and PAPER minted: API trade rows reconciled to mint Transfer events; total supply and total staked",
    "Our wallet PAPER/staked balances and pendingReward(address), accumulator snapshots, distributed rewards, claims, and externally withdrawn USDC; include claim receipt to avoid double count",
    "USDC equity bridge: deposits, withdrawals, available, locked margin, queue claims and cash dividends; separate unrealized PnL and zero cash mark for nontransferable PAPER",
    "Protocol summary, minute queue snapshots, house history, reward distributions, cap/headroom/OI, implementation and 24h timelock changes",
    "Daily oracle evidence packet and panel validity; use separate BTC rubric if marketId=0",
    "Rolling 7/15/30-day rewards per PAPER, supply growth, our diluted stake share and own fee contribution; unavailable 90-day history remains unavailable",
    "Frozen shadow trades, executable BBO tracking errors, sign/submit/confirm latency and failed-intent log; compare pre-registered rule against cash and random-side control"
  ],
  "reviewOutputs": [
    "Strict JSON patch containing only allowed recommended fields, expected previous version/hash, asOfUtc and expiresAtUtc; reject unknown fields, stale versions, nonfinite values or bound changes",
    "Oracle int256 answer and separate evidence packet/hash, panel min/max/median and VALID/INVALID status",
    "Reconciled daily and cumulative net cash PnL + USDC dividends, PAPER minted and eligible loss basis; staking and queue accrual separately, no token terminal mark",
    "Updated 30/90/180-day dividend distribution and dilution/queue/parameter stresses, with data window and assumptions; incremental versus existing-stake baseline",
    "Per-candidate 90-day cash simulation mean/p10/p90, realized and stressed drawdowns, limits/headroom and decision OBSERVE/HALT; no execution in v1",
    "Adversarial review: evidence gaps, regime/latency sensitivity, endogenous-reward and survivorship checks; explicit pass/fail for every kill condition",
    "New entries, full-close intents and claim/stake suggestions for an independently authorized future execution version only; this version must output an empty transaction list"
  ],
  "killConditions": [
    "executionEnabled must remain 0 in version 1: any attempted submission is rejected; a new reviewed policy version is required to enable trading",
    "Any payout queue >0 USD, missing/stale queue state, negative tracked LP, or reward distribution suppressed; do not farm an insolvency bonus",
    "Any change in implementation, impact/deadband/holdback, win/loss/builder fee, mint coefficient, reward allocation, LP cap, custody asset or timelock configuration; freeze on a scheduled material change",
    "Daily net cash loss >= dailyLossLimitFraction, trailing 7-day loss >= weeklyLossLimitFraction, or peak cash-equity drawdown >= drawdownKillFraction; unrealized losses count for entry gating",
    "Open margin, gross/net notional, concurrency, OI share/headroom or free-cash limit exceeded; minimum venue order exceeds permitted size => skip",
    "Invalid oracle/panel, expired evidence, bad candles, BBO mismatch > maxEntryDriftBps, relayer failure, or pair-leg delay > maxPairLegDelaySeconds => cancel further entries and request full closes where permitted",
    "Unknown actual bustPrice, stop distance too close to bust, no continuously available guard, or stopped guard heartbeat => no leverage entries",
    "7-day per-PAPER reward below minRewardRate7dPerPaperDay, supply log growth above maxSupplyLogGrowthDaily, or our stake share above maxStakingShare => no loss-farm entries",
    "Prospective 90-day total cash economics p10 <= minNetValue90PerUsdMargin (no confidence from recycled holdout), or any gate relies on future PAPER value for sizing => no farm",
    "Unreconciled cash or mint discrepancy, delayed claim/withdrawal, retired instrument, opens pause, chain reorg/outage or custody/USDC depeg observation => halt and escalate"
  ],
  "metricDefinitions": {
    "expectedDailyValuePerUsdMargin": "Mean of (90-day trading cash PnL plus USDC dividends earned within those same 90 days)/90 per fixed $1 total margin budget per daily decision, from saved historical calendar block resamples and explicit judgmental revenue/dilution regimes. Excludes pre-existing stake, token price, idle-cash yield and queue recovery. Hypothetical, not a forecast guarantee.",
    "p10": "10th percentile of the same 90-day average daily economics",
    "p90": "90th percentile of the same 90-day average daily economics",
    "maxDrawdown": "Historical realized equity drawdown as fraction using 1% current equity committed per trade/group, prior to proposed risk gates, without dividends; not a worst-case bound.",
    "modeCodes": {
      "0": "observe",
      "1": "equal-notional pair",
      "2": "directional",
      "3": "biased equal-leverage pair"
    },
    "signalModeCodes": {
      "0": "live oracle panel (not backtested)",
      "1": "24h/72h trend agreement candle proxy",
      "2": "opposite of 24h/72h trend agreement, exploratory comparator"
    },
    "marketCodes": {
      "0": "BTC",
      "1": "ETH"
    },
    "versionPolicy": "Bounds, schemas, candidates, review rules and kill conditions are immutable to recurring review. Validate a recommended-only patch against the trusted shipped schema and cross-field policy, not against editable JSON bounds. executionEnabled pinned to zero."
